{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "src/**/*.ts", "*.d.ts"],
  "exclude": [
    "dist",
    "bin",
    "node_modules",
    "scripts/**/dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
